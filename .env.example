# Copy to .env and fill values as needed.

# Owner (user or organisation) and personal access token used by
# enable-all-workflows / delete-old-workflow-runs when --owner / --token are not given.
SECRET_GITHUB_OWNER=
SECRET_GITHUB_TOKEN=

# Codecov upload token (required for private repos; optional for public repos)
CODECOV_TOKEN=

# PyPI API token. The release workflow (.github/workflows/default_release_public.yml) reads the
# PYPI_API_TOKEN repository secret, not this file, and publishes via a PyPI Trusted Publisher
# when that secret is unset.
PYPI_API_TOKEN=

# Optional: GitHub token for API-limited tasks
GITHUB_TOKEN=
